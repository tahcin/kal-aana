# Copy to .env and paste your SerpApi key (https://serpapi.com/manage-api-key).
# Without a key the app runs in demo mode from the committed snapshot and cached results.
SERPAPI_API_KEY=
# Max fresh (paid) searches a single run may spend, unless --budget is given. Cached results are free.
KALAANA_SEARCH_BUDGET=40

# The ask box's reader: rules (default, offline), ollama, llamacpp, openai or anthropic. Rules always check its answer.
KALAANA_READER=
# The model for that reader, e.g. gemma3:4b (ollama) or claude-haiku-5-5 (anthropic, the default there).
KALAANA_MODEL=
# For KALAANA_READER=anthropic (needs: pip install -e ".[claude]"). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The ask box stops calling a paid API (and falls back to rules) once its estimated spend reaches this many US dollars.
KALAANA_ASK_BUDGET_USD=10
