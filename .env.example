# Copy to .env and paste your SerpApi key (https://serpapi.com/manage-api-key).
# Without a key the app runs in demo mode from the committed snapshot and cached results.
SERPAPI_API_KEY=
# Max fresh (paid) searches a single run may spend, unless --budget is given. Cached results are free.
KALAANA_SEARCH_BUDGET=40

# The model behind the chat and the ask box: rules (default, offline, free), openai, anthropic, ollama or llamacpp.
# openai means any OpenAI-compatible Chat Completions API with tool calling; the chat runs it as an agent over its tools.
# Rules always check its answer. Examples (base URL, model):
#   Claude       https://api.anthropic.com/v1/                               claude-sonnet-5-5 (ANTHROPIC_API_KEY works too)
#   OpenAI       https://api.openai.com/v1 (the default)                     a GPT model with tool calling
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai/    a Gemini model
#   OpenRouter   https://openrouter.ai/api/v1                                any model it lists with tool support
#   Groq         https://api.groq.com/openai/v1                              a model with tool use
#   Ollama       http://localhost:11434/v1 (no key; free, not counted)       e.g. qwen3:8b (one that supports tools)
#   llama.cpp, LM Studio, vLLM: their server's /v1 address
KALAANA_READER=
OPENAI_BASE_URL=
OPENAI_API_KEY=
# The model. For openai it is required. For anthropic it is the ask box's field reader (default claude-haiku-5-5);
# for ollama, e.g. gemma3:4b.
KALAANA_MODEL=
# The chat's model, if it should differ from KALAANA_MODEL (anthropic's default here is claude-sonnet-5-5).
KALAANA_CHAT_MODEL=
# For KALAANA_READER=anthropic: Claude through the Anthropic SDK, which adds prompt caching
# (needs: pip install -e ".[claude]"). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# The chat and the ask box stop calling a paid API (and fall back to rules) once its estimated spend reaches this many
# US dollars. A server on this machine (localhost) is free and not counted.
KALAANA_ASK_BUDGET_USD=10
